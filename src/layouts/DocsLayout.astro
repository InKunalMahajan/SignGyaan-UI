---
import '../styles/global.css';
const {title='SignGyaan UI',description='Free, accessible Tailwind CSS components'}=Astro.props;
const groups=[
 {title:'Start',links:[['Overview','/'],['Installation','/docs/installation/'],['Architecture','/docs/architecture/']]},
 {title:'Foundations',links:[['Tokens','/docs/tokens/'],['Themes','/docs/themes/'],['Accessibility','/docs/accessibility/']]},
 {title:'Components',links:[['Button','/docs/button/'],['Card','/docs/card/'],['Badge','/docs/badge/'],['Input','/docs/input/'],['Alert','/docs/alert/'],['Progress','/docs/progress/'],['Spinner','/docs/spinner/'],['Checkbox','/docs/checkbox/'],['Select','/docs/select/'],['Tabs','/docs/tabs/'],['Modal','/docs/modal/'],['Navbar','/docs/navbar/'],['Sidebar','/docs/sidebar/']]},
 {title:'Frameworks',links:[['Blade','/docs/blade/'],['React','/docs/react/'],['Vue','/docs/vue/']]}
];
const base = import.meta.env.BASE_URL;
const url = (path) => base + path.replace(/^\//, '');
const pathname=Astro.url.pathname.replace(base, '/').replace(/\/+/g,'/');
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<title>{title} | SignGyaan UI</title>
<script is:inline>try { document.documentElement.dataset.theme=localStorage.getItem('sg-theme')==='dark'?'dark':'light'; } catch (_) {}</script>
</head>
<body class="min-h-screen">
<header class="sticky top-0 z-40 border-b border-sg-border bg-sg-surface">
 <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4">
  <a href={url("/")} class="flex items-center gap-2 font-bold no-underline"><span class="rounded-sg bg-sg-primary px-2.5 py-2 text-white">SG</span>SignGyaan UI</a>
  <nav class="hidden gap-5 text-sm md:flex" aria-label="Main"><a href={url("/docs/installation/")}>Docs</a><a href={url("/docs/button/")}>Components</a><a href="https://github.com/InKunalMahajan/SignGyaan-UI">GitHub</a></nav>
  <div class="flex gap-2"><button id="theme-button" type="button" class="sg-button sg-button-outline sg-button-sm" aria-label="Toggle dark mode">◐ Theme</button><button id="menu-button" type="button" class="sg-button sg-button-outline sg-button-sm lg:hidden" aria-controls="docs-sidebar" aria-expanded="false">Menu</button></div>
 </div>
</header>
<div class="mx-auto flex max-w-7xl gap-8 px-4">
 <aside id="docs-sidebar" class="hidden w-56 shrink-0 border-r border-sg-border py-8 lg:block" aria-label="Documentation">
  {groups.map(group=><section class="mb-6"><h2 class="mb-2 text-xs font-bold uppercase text-sg-muted">{group.title}</h2><ul>{group.links.map(([name,href])=><li><a href={url(href)} aria-current={pathname===href?'page':undefined} class:list={['block rounded-sg px-3 py-2 text-sm hover:bg-sg-page',pathname===href?'font-semibold text-sg-primary':'text-sg-muted']}>{name}</a></li>)}</ul></section>)}
 </aside>
 <main id="main-content" class="min-w-0 flex-1 py-10"><slot /><footer class="mt-20 border-t border-sg-border pt-6 text-xs text-sg-muted">SignGyaan UI · Astro + Tailwind CSS · MIT Licensed</footer></main>
</div>
<script>
 document.getElementById('theme-button')?.addEventListener('click',()=>{
  const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=theme;
  try {localStorage.setItem('sg-theme',theme);} catch (_) {}
 });
 document.getElementById('menu-button')?.addEventListener('click',()=>{
  const sidebar=document.getElementById('docs-sidebar');
  const visible=sidebar?.classList.toggle('hidden')===false;
  document.getElementById('menu-button')?.setAttribute('aria-expanded',String(visible));
 });
</script>
</body></html>

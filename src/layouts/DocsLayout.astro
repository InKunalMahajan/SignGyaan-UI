---
import '../styles/global.css';
const {title='SignGyaan UI',description='Free, accessible Tailwind CSS components'}=Astro.props;
const groups=[
 {title:'Start',links:[['Overview','/'],['Installation','/docs/installation/'],['Architecture','/docs/architecture/']]},
 {title:'Foundations',links:[['Tokens','/docs/tokens/'],['Themes','/docs/themes/'],['Accessibility','/docs/accessibility/']]},
 {title:'Components',links:[['Button','/docs/button/'],['Card','/docs/card/'],['Badge','/docs/badge/'],['Input','/docs/input/'],['Alert','/docs/alert/'],['Progress','/docs/progress/'],['Spinner','/docs/spinner/'],['Checkbox','/docs/checkbox/'],['Select','/docs/select/'],['Tabs','/docs/tabs/'],['Modal','/docs/modal/'],['Navbar','/docs/navbar/'],['Sidebar','/docs/sidebar/'],['Radio','/docs/radio/'],['Textarea','/docs/textarea/'],['Switch','/docs/switch/'],['Accordion','/docs/accordion/'],['Table','/docs/table/'],['Avatar','/docs/avatar/'],['Separator','/docs/separator/']]},
 {title:'Frameworks',links:[['Blade','/docs/blade/'],['React','/docs/react/'],['Vue','/docs/vue/']]}
];
const base = import.meta.env.BASE_URL;
const url = (path) => base + path.replace(/^\//, '');
const pathname=Astro.url.pathname.replace(base, '/').replace(/\/+/g,'/');
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<title>{title} | SignGyaan UI</title>
<script is:inline>try { document.documentElement.dataset.theme=localStorage.getItem('sg-theme')==='dark'?'dark':'light'; } catch (_) {}</script>
</head>
<body class="min-h-screen">
<a class="sg-skip-link" href="#main-content">Skip to main content</a>
<header class="sticky top-0 z-40 border-b border-sg-border bg-sg-surface">
 <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-2 px-3 py-2 sm:px-4">
  <a href={url("/")} class="flex min-w-0 items-center gap-2 text-sm font-bold no-underline sm:text-base"><span class="rounded-sg bg-sg-primary px-2.5 py-2 text-white">SG</span><span class="truncate">SignGyaan UI</span></a>
  <nav class="hidden gap-5 text-sm md:flex" aria-label="Main"><a href={url("/docs/installation/")}>Docs</a><a href={url("/docs/button/")}>Components</a><a href="https://github.com/InKunalMahajan/SignGyaan-UI">GitHub</a></nav>
  <div class="flex shrink-0 gap-2"><button id="theme-button" type="button" class="sg-button sg-button-outline sg-button-sm" aria-label="Switch to dark mode" aria-pressed="false"><span aria-hidden="true">◐</span> <span id="theme-label">Dark</span></button><button id="menu-button" type="button" class="sg-button sg-button-outline sg-button-sm lg:hidden" aria-controls="docs-sidebar" aria-expanded="false" aria-label="Open documentation menu"><span id="menu-label">Menu</span></button></div>
 </div>
</header>
<div class="mx-auto flex max-w-7xl flex-col gap-0 px-4 lg:flex-row lg:gap-8">
 <aside id="docs-sidebar" class="hidden w-full shrink-0 border-b border-sg-border bg-sg-surface py-4 lg:sticky lg:top-16 lg:block lg:h-[calc(100vh-4rem)] lg:w-56 lg:overflow-y-auto lg:border-b-0 lg:border-r lg:py-8" aria-label="Documentation">
  {groups.map(group=><section class="mb-6"><h2 class="mb-2 text-xs font-bold uppercase text-sg-muted">{group.title}</h2><ul>{group.links.map(([name,href])=><li><a href={url(href)} aria-current={pathname===href?'page':undefined} class:list={['block rounded-sg px-3 py-2 text-sm hover:bg-sg-page',pathname===href?'font-semibold text-sg-primary':'text-sg-muted']}>{name}</a></li>)}</ul></section>)}
 </aside>
 <main id="main-content" tabindex="-1" class="min-w-0 flex-1 py-8 lg:py-10"><slot /><footer class="mt-20 border-t border-sg-border pt-6 text-xs text-sg-muted">SignGyaan UI · Astro + Tailwind CSS · MIT Licensed</footer></main>
</div>
<script>
 const themeButton=document.getElementById('theme-button');
 const themeLabel=document.getElementById('theme-label');
 function syncThemeButton() {
   const dark=document.documentElement.dataset.theme==='dark';
   themeButton?.setAttribute('aria-pressed',String(dark));
   themeButton?.setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode');
   if(themeLabel)themeLabel.textContent=dark?'Light':'Dark';
 }
 syncThemeButton();
 themeButton?.addEventListener('click',()=>{
   const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';
   document.documentElement.dataset.theme=theme;
   try {localStorage.setItem('sg-theme',theme);} catch (_) {}
   syncThemeButton();
 });
 const menuButton=document.getElementById('menu-button');
 const sidebar=document.getElementById('docs-sidebar');
 const menuLabel=document.getElementById('menu-label');
 const desktop=window.matchMedia('(min-width: 1024px)');
 const isOpen=()=>menuButton?.getAttribute('aria-expanded')==='true';
 function setMenuOpen(open, restoreFocus=false) {
   if (!menuButton || !sidebar) return;
   menuButton.setAttribute('aria-expanded',String(open));
   menuButton.setAttribute('aria-label',open?'Close documentation menu':'Open documentation menu');
   if (menuLabel) menuLabel.textContent=open?'Close':'Menu';
   if (!desktop.matches) sidebar.classList.toggle('hidden',!open);
   if (restoreFocus) menuButton.focus();
 }
 menuButton?.addEventListener('click',()=>{
   const open=!isOpen();
   setMenuOpen(open);
   if(open) sidebar?.querySelector('a')?.focus();
 });
 document.addEventListener('keydown',event=>{
   if(event.key==='Escape' && isOpen() && !desktop.matches) {
     setMenuOpen(false,true);
   }
 });
 sidebar?.addEventListener('click',event=>{
   if(event.target instanceof Element && event.target.closest('a') && !desktop.matches) {
     setMenuOpen(false);
   }
 });
 document.addEventListener('pointerdown',event=>{
   if(!desktop.matches && isOpen() && event.target instanceof Node && !sidebar?.contains(event.target) && !menuButton?.contains(event.target)) setMenuOpen(false);
 });
 desktop.addEventListener('change',()=>{
   if(sidebar) sidebar.classList.toggle('hidden',!desktop.matches);
   setMenuOpen(false);
 });
</script>
</body></html>

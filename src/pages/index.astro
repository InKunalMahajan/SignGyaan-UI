---
import DocsLayout from '../layouts/DocsLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const base=import.meta.env.BASE_URL;
const url=(path:string)=>base+path.replace(/^\//,'');
---
<DocsLayout title="Home">
 <section class="sg-page-intro sg-home-intro">
  <PageHeader eyebrow="SIGNGYAAN UI · FREE OPEN-SOURCE COMPONENTS" title="Build better interfaces, faster." description="Simple, reusable Tailwind CSS components with clear documentation for HTML, Laravel Blade, React and Vue."/>
  <div class="sg-home-actions">
   <a class="sg-button sg-button-primary" href={url('/docs/installation/')}>Get started</a>
   <a class="sg-button sg-button-outline" href={url('/components/')}>Browse 20 components</a>
  </div>
 </section>
 <section aria-label="Explore SignGyaan UI" class="sg-home-simple-grid">
  <a href={url('/docs/installation/')}>
   <h2>Get started</h2>
   <p>Installation and first steps with the CSS library.</p>
  </a>
  <a href={url('/components/')}>
   <h2>Components</h2>
   <p>Explore 20 Free components with live examples.</p>
  </a>
  <a href={url('/docs/tokens/')}>
   <h2>Design foundations</h2>
   <p>Colors, tokens, themes and accessibility principles.</p>
  </a>
 </section>
 <section class="mt-10">
  <div class="mb-5">
   <h2 class="text-xl font-bold">Component preview</h2>
   <p class="mt-2 text-sm text-sg-muted">See how the buttons and status badge look with the shared design system.</p>
  </div>
  <div class="sg-card">
   <div class="flex flex-wrap items-center gap-3">
    <button type="button" class="sg-button sg-button-primary" id="demo-action">Try button</button>
    <a class="sg-button sg-button-outline" href={url('/docs/button/')}>Button documentation</a>
    <span class="sg-badge">Active</span>
   </div>
   <p id="demo-action-result" class="mt-4 text-sm text-sg-muted" role="status" aria-live="polite">Select Try button to test the interaction.</p>
  </div>
 </section>
</DocsLayout>
<script>
 document.querySelector('#demo-action')?.addEventListener('click',()=>{
  const result=document.querySelector('#demo-action-result');
  if(result)result.textContent='Button is working.';
 });
</script>

---
import DocsLayout from '../layouts/DocsLayout.astro';
const base = import.meta.env.BASE_URL;
const url = (path) => base + path.replace(/^\//, '');
---
<DocsLayout title="Home">
<section class="py-10">
  <span class="sg-badge">Open source • Free core</span>
  <h1 class="mt-6 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">Build accessible interfaces with SignGyaan UI.</h1>
  <p class="mt-5 max-w-2xl text-lg leading-8 text-sg-muted">One Tailwind CSS v4 design system, reusable in Laravel Blade, React, Vue and plain HTML. No Starlight, no purchased theme, and no starter kit.</p>
  <div class="mt-7 flex flex-wrap gap-3"><a class="sg-button sg-button-primary" href={url("/docs/installation/")}>Get started</a><a class="sg-button sg-button-outline" href={url("/docs/button/")}>Explore components</a></div>
</section>
<section class="grid gap-5 py-8 md:grid-cols-3">
 <article class="sg-card"><h2 class="text-lg font-bold">Shared CSS</h2><p class="mt-3 text-sm leading-7 text-sg-muted">Tokens, themes and seven free components.</p></article>
 <article class="sg-card"><h2 class="text-lg font-bold">Framework adapters</h2><p class="mt-3 text-sm leading-7 text-sg-muted">Blade, React and Vue examples share consistent class names.</p></article>
 <article class="sg-card"><h2 class="text-lg font-bold">Accessible defaults</h2><p class="mt-3 text-sm leading-7 text-sg-muted">Semantic HTML, visible focus and responsive layout foundations.</p></article>
</section>
<section class="mt-8 sg-card"><h2 class="mb-4 text-xl font-bold">Component preview</h2><div class="flex flex-wrap items-center gap-3"><button class="sg-button sg-button-primary">Primary</button><button class="sg-button sg-button-secondary">Secondary</button><button class="sg-button sg-button-outline">Outline</button><span class="sg-badge">Active</span><span class="sg-spinner" role="status" aria-label="Loading"></span></div></section>
</DocsLayout>

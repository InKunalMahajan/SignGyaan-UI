---
import {getCollection, render} from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
export async function getStaticPaths(){
 const docs=await getCollection('docs');
 return docs.map(entry=>({params:{slug:entry.id.replace(/\.md$/,'')},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description}>
  <article class="docs mx-auto max-w-3xl">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-sg-primary">Documentation</p>
    <h1>{entry.data.title}</h1>
    {entry.data.description&&<p class="mb-8 text-lg">{entry.data.description}</p>}
    <Content/>
  </article>
</DocsLayout>

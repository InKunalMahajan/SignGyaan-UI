---
import {getCollection, render} from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import ComponentDemo from '../../components/ComponentDemo.astro';
import PageHeader from '../../components/PageHeader.astro';
export async function getStaticPaths(){
 const docs=await getCollection('docs');
 return docs.map(entry=>({params:{slug:entry.id.replace(/\.md$/,'')},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const pageOrder=['installation','architecture','tokens','themes','accessibility','button','badge','alert','spinner','progress','modal','input','textarea','select','checkbox','radio','switch','navbar','sidebar','tabs','accordion','separator','card','table','avatar','blade','react','vue'];
const currentIndex=pageOrder.indexOf(entry.id);
const base=import.meta.env.BASE_URL;
const link=(slug:string)=>base+'docs/'+slug+'/';
const previous=currentIndex>0?pageOrder[currentIndex-1]:null;
const next=currentIndex>=0&&currentIndex<pageOrder.length-1?pageOrder[currentIndex+1]:null;
const demos=new Set(['button','card','badge','input','alert','progress','spinner','checkbox','select','tabs','modal','navbar','sidebar','radio','textarea','switch','accordion','table','avatar','separator']);
---
<DocsLayout title={entry.data.title} description={entry.data.description}>
  <article class="docs mx-auto max-w-3xl">
    <PageHeader eyebrow={demos.has(entry.id)?'FREE COMPONENT':'DEVELOPER GUIDE'} title={entry.data.title} description={entry.data.description}/>
    {demos.has(entry.id) && <ComponentDemo component={entry.id}/>}
    <Content/>
    <nav class="sg-page-pagination" aria-label="Previous and next documentation pages">
      {previous?<a href={link(previous)}><span>← Previous</span><strong>{previous.replace(/(^.|-.)/g, s=>s.replace("-","").toUpperCase())}</strong></a>:<span aria-hidden="true"></span>}
      {next&&<a href={link(next)}><span>Next →</span><strong>{next.replace(/(^.|-.)/g, s=>s.replace("-","").toUpperCase())}</strong></a>}
    </nav>
  </article>
</DocsLayout>

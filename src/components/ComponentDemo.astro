---
interface Props { component: string }
const { component } = Astro.props;
const examples: Record<string,string> = {
 button: '<button class="sg-button sg-button-primary">Continue Learning</button>',
 card: '<article class="sg-card"><h3>Basic Computer</h3><p>Continue your course.</p></article>',
 badge: '<span class="sg-badge">Active</span>',
 input: '<label for="course">Course name</label>\n<input id="course" class="sg-input" placeholder="Basic Computer" />',
 alert: '<div class="sg-alert" role="status">Your changes were saved.</div>',
 progress: '<div class="sg-progress" role="progressbar" aria-label="Course completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="65"><div class="sg-progress-bar" style="width:65%"></div></div>',
 spinner: '<span class="sg-spinner" role="status" aria-label="Loading"></span>',
 checkbox: '<label><input class="sg-checkbox" type="checkbox" /> Email updates</label>',
 select: '<label for="subject">Subject</label>\n<select id="subject" class="sg-select"><option>Mathematics</option><option>Computer</option></select>',
 tabs: '<div role="tablist" class="sg-tabs"><button role="tab" class="sg-tab" aria-selected="true">Overview</button><button role="tab" class="sg-tab" aria-selected="false">Lessons</button></div>',
 modal: '<dialog class="sg-modal"><h3>Confirm action</h3><button class="sg-button sg-button-outline">Close</button></dialog>',
 navbar: '<nav class="sg-navbar" aria-label="Example"><a href="#">SignGyaan</a><a href="#">Courses</a></nav>',
 sidebar: '<nav class="sg-sidebar" aria-label="Example"><a class="sg-nav-link" aria-current="page" href="#">Dashboard</a><a class="sg-nav-link" href="#">Courses</a></nav>'
};
const code=examples[component]||'';
---
{code && <section class="sg-demo my-6 overflow-hidden rounded-sg-card border border-sg-border" data-demo={component}>
 <div class="flex flex-wrap items-center justify-between gap-3 border-b border-sg-border bg-sg-surface px-4 py-3">
  <span class="text-sm font-semibold text-sg-ink">Live preview</span>
  <button type="button" class="sg-button sg-button-outline sg-button-sm" data-copy-code>Copy HTML</button>
 </div>
 <div class="bg-sg-page p-5 sm:p-7" data-preview>
  {component==='button' && <div class="flex flex-wrap gap-3"><button type="button" class="sg-button sg-button-primary" data-message="Primary clicked">Primary</button><button type="button" class="sg-button sg-button-secondary" data-message="Secondary clicked">Secondary</button><button type="button" class="sg-button sg-button-outline" data-message="Outline clicked">Outline</button><button type="button" class="sg-button sg-button-primary sg-button-sm">Small</button><button type="button" disabled class="sg-button sg-button-primary">Disabled</button><p class="w-full text-sm text-sg-muted" aria-live="polite" data-output>Choose an enabled button.</p></div>}
  {component==='card' && <article class="sg-card max-w-sm"><h3 class="mb-2 font-semibold">Basic Computer</h3><p class="mb-4 text-sm text-sg-muted">Introduction to Computers</p><span class="sg-badge">In progress</span></article>}
  {component==='badge' && <div class="flex flex-wrap items-center gap-3"><span class="sg-badge">Active</span><span class="rounded-full bg-slate-200 px-3 py-1 text-xs text-slate-800">Draft</span></div>}
  {component==='input' && <div class="max-w-sm"><label class="mb-2 block text-sm font-medium" for="demo-course">Course name</label><input id="demo-course" type="text" class="sg-input" placeholder="Basic Computer"/><p class="mt-2 text-xs text-sg-muted">Enter a course name.</p></div>}
  {component==='alert' && <div class="sg-alert" role="status">Your changes were saved successfully.</div>}
  {component==='progress' && <div class="max-w-sm"><label class="mb-3 block text-sm" for="demo-progress">Course completion: <output data-progress-label>65%</output></label><div class="sg-progress" role="progressbar" aria-label="Course completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="65" data-progress-track><div class="sg-progress-bar" style="width:65%" data-progress-fill></div></div><input class="mt-4 w-full" id="demo-progress" type="range" min="0" max="100" value="65" data-progress-range/></div>}
  {component==='spinner' && <div class="flex items-center gap-3"><span class="sg-spinner" role="status" aria-label="Loading"></span><span class="text-sm text-sg-muted">Loading your course...</span></div>}
  {component==='checkbox' && <label class="flex items-center gap-3"><input type="checkbox" class="sg-checkbox" checked/>Send me learning updates</label>}
  {component==='select' && <div class="max-w-sm"><label class="mb-2 block text-sm font-medium" for="demo-subject">Subject</label><select id="demo-subject" class="sg-select"><option>Basic Computer</option><option>Mathematics</option><option>English</option></select></div>}
  {component==='tabs' && <div><div class="sg-tabs" role="tablist" aria-label="Course sections" data-tabs><button type="button" class="sg-tab" role="tab" id="demo-tab-overview" aria-controls="demo-panel-overview" aria-selected="true" tabindex="0">Overview</button><button type="button" class="sg-tab" role="tab" id="demo-tab-lessons" aria-controls="demo-panel-lessons" aria-selected="false" tabindex="-1">Lessons</button></div><section class="py-4 text-sm text-sg-ink" role="tabpanel" id="demo-panel-overview" aria-labelledby="demo-tab-overview" tabindex="0">Learn the basics of computer science.</section><section class="py-4 text-sm text-sg-ink" role="tabpanel" id="demo-panel-lessons" aria-labelledby="demo-tab-lessons" tabindex="0" hidden>Lesson 1: Introduction to computers.</section></div>}
  {component==='modal' && <div><button type="button" class="sg-button sg-button-primary" data-open-modal>Open modal</button><dialog class="sg-modal w-[min(90vw,28rem)]" data-modal aria-labelledby="demo-modal-title"><h3 class="mb-2 text-lg font-semibold" id="demo-modal-title">Continue learning?</h3><p class="mb-5 text-sm text-sg-muted">Your course progress will be saved.</p><form method="dialog"><button class="sg-button sg-button-outline">Close</button></form></dialog></div>}
  {component==='navbar' && <nav class="sg-navbar rounded-sg" aria-label="Component preview"><span class="font-bold">SignGyaan</span><div class="flex flex-wrap gap-3 text-sm"><span>Home</span><span>Courses</span><span>Docs</span></div></nav>}
  {component==='sidebar' && <nav class="sg-sidebar rounded-sg" aria-label="Component preview"><span class="mb-2 block text-xs font-semibold text-sg-muted">LEARNER</span><a class="sg-nav-link" aria-current="page" href="#main-content">Dashboard</a><a class="sg-nav-link" href="#main-content">Courses</a><a class="sg-nav-link" href="#main-content">Scoreboard</a></nav>}
 </div>
 <div class="flex items-center justify-between border-t border-sg-border px-4 py-2"><span class="text-xs text-sg-muted">HTML / shared sg-* CSS classes</span></div>
 <pre class="!m-0 !rounded-none text-xs"><code>{code}</code></pre>
</section>}
<script>
 document.querySelectorAll<HTMLElement>('[data-demo]').forEach(demo=>{
   if(demo.dataset.ready==='true')return;
   demo.dataset.ready='true';
   demo.querySelector<HTMLButtonElement>('[data-copy-code]')?.addEventListener('click',async e=>{
     const button=e.currentTarget as HTMLButtonElement;
     const code=demo.querySelector('pre code')?.textContent||'';
     try {await navigator.clipboard.writeText(code);button.textContent='Copied!';}
     catch {button.textContent='Select code to copy';}
   });
   demo.querySelectorAll<HTMLButtonElement>('[data-message]').forEach(button=>button.addEventListener('click',()=>{
     const output=demo.querySelector<HTMLElement>('[data-output]');
     if(output)output.textContent=button.dataset.message||'Clicked';
   }));
   const range=demo.querySelector<HTMLInputElement>('[data-progress-range]');
   range?.addEventListener('input',()=>{
     const value=range.value;
     const fill=demo.querySelector<HTMLElement>('[data-progress-fill]');
     const track=demo.querySelector<HTMLElement>('[data-progress-track]');
     const label=demo.querySelector<HTMLElement>('[data-progress-label]');
     if(fill) fill.style.width=value+'%';
     if(track)track.setAttribute('aria-valuenow',value);
     if(label)label.textContent=value+'%';
   });
   const dialog=demo.querySelector<HTMLDialogElement>('[data-modal]');
   demo.querySelector<HTMLButtonElement>('[data-open-modal]')?.addEventListener('click',()=>dialog?.showModal());
   const tabs=Array.from(demo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
   function activate(index:number,focus=true){
      tabs.forEach((tab,i)=>{
        const selected=i===index;
        tab.setAttribute('aria-selected',String(selected));
        tab.tabIndex=selected?0:-1;
        const target=tab.getAttribute('aria-controls');
        if(target){const panel=demo.querySelector<HTMLElement>('#'+target);if(panel)panel.hidden=!selected;}
      });
      if(focus)tabs[index]?.focus();
   }
   tabs.forEach((tab,i)=>{
      tab.addEventListener('click',()=>activate(i,false));
      tab.addEventListener('keydown',(event)=>{
        let next=i;
        if(event.key==='ArrowRight')next=(i+1)%tabs.length;
        else if(event.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;
        else if(event.key==='Home')next=0;
        else if(event.key==='End')next=tabs.length-1;
        else return;
        event.preventDefault();activate(next);
      });
   });
 });
</script>
